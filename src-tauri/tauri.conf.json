{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDD Console",
  "version": "0.1.0",
  "identifier": "com.gdd.console",
  "build": {
    "frontendDist": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
